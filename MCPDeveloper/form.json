{
  "elements": [
    {
      "type": "Label",
      "caption": "Symcon MCP Werkstatt – Symcon ab 8.1. Endpunkt: /hook/symcon-mcp-<Instanz-ID>"
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Zugang aktivieren"
    },
    {
      "type": "PasswordTextBox",
      "name": "Token",
      "caption": "Bearer-Token (mindestens 32 Zeichen)"
    },
    {
      "type": "CheckBox",
      "name": "AllowTokenInPath",
      "caption": "Token auch in der Adresse (für ChatGPT ohne separate Anmeldung)"
    },
    {
      "type": "SelectCategory",
      "name": "RootID",
      "caption": "Standard-Arbeitsbereich (0 = kein Standardziel; zusätzliche Schreibbereiche weiterhin möglich)"
    },
    {
      "type": "List",
      "name": "ReadOnlyCategories",
      "caption": "Kategorien – Zugriffsrechte",
      "rowCount": 4,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Kategorie (einschließlich Unterobjekte)",
          "name": "CategoryID",
          "width": "auto",
          "add": 0,
          "edit": {
            "type": "SelectCategory"
          }
        },
        {
          "caption": "Zugriffsrechte",
          "name": "Access",
          "width": "220px",
          "add": "read",
          "edit": {
            "type": "Select",
            "options": [
              { "caption": "Kein Zugriff", "value": "none" },
              { "caption": "Nur lesen", "value": "read" },
              { "caption": "Lesen und schreiben", "value": "write" }
            ]
          }
        }
      ]
    },
    {
      "type": "List",
      "name": "DeniedCategories",
      "caption": "Gesperrte Kategorien – weder lesen noch schreiben",
      "rowCount": 4,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Kategorie (einschließlich Unterobjekte)",
          "name": "CategoryID",
          "width": "auto",
          "add": 0,
          "edit": {
            "type": "SelectCategory"
          }
        }
      ]
    },
    {
      "type": "List",
      "name": "ReadOnlyInstances",
      "caption": "Instanzen – Zugriffsrechte",
      "form": "return json_decode(SMCP_UIInstanceAccessForm($id, $ReadOnlyInstances['InstanceID'] ?? 0, $ReadOnlyInstances['ReadConfiguration'] ?? false, $ReadOnlyInstances['AllProperties'] ?? true, json_encode($ReadOnlyInstances['PropertySelection'] ?? []), $ReadOnlyInstances['Access'] ?? 'read'), true);",
      "rowCount": 4,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Instanz mit Unterobjekten",
          "name": "InstanceID",
          "width": "auto",
          "add": 0,
          "edit": { "type": "SelectInstance" }
        },
        {
          "caption": "Zugriffsrechte",
          "name": "Access",
          "width": "220px",
          "add": "read",
          "edit": {
            "type": "Select",
            "options": [
              { "caption": "Kein Zugriff", "value": "none" },
              { "caption": "Nur lesen", "value": "read" },
              { "caption": "Lesen und schreiben", "value": "write" }
            ]
          }
        },
        {
          "caption": "Konfiguration lesen",
          "name": "ReadConfiguration",
          "width": "200px",
          "add": false,
          "edit": { "type": "CheckBox", "caption": "Konfiguration lesen" }
        },
        {
          "caption": "Alle Eigenschaften",
          "name": "AllProperties",
          "width": "180px",
          "add": true,
          "edit": { "type": "CheckBox" }
        },
        {
          "caption": "Einzelauswahl",
          "name": "PropertySelection",
          "visible": false,
          "width": "200px",
          "add": [],
          "edit": { "type": "List", "columns": [] }
        },
        {
          "caption": "Bisherige Eigenschaftsauswahl (0.3.0)",
          "name": "Properties",
          "visible": false,
          "width": "200px",
          "add": "",
          "save": true
        }
      ]
    },
    {
      "type": "Label",
      "caption": "Konfiguration lesen aktivieren. Danach entweder alle Eigenschaften erlauben oder im Bearbeitungsdialog einzelne Felder anhaken. Kein Haken bei Konfiguration lesen bedeutet nur Metadaten. Bekannte Zugangsfelder werden gefiltert; ungewöhnlich benannte Geheimnisse können unerkannt bleiben. Sperren haben Vorrang."
    },
    {
      "type": "Label",
      "caption": "Rechte gelten einschließlich Unterobjekten. Priorität: gesperrt/kein Zugriff > nur lesen > lesen und schreiben. Globale Schreib- und Ausführungsfreigaben gelten zusätzlich. Die Modulinstanz und ihre Kinder bleiben gesperrt. Schreibrechte erlauben vorhandene Objekt-/Variablen-/Skriptwerkzeuge; sie ändern keine Instanzkonfiguration automatisch."
    },
    {
      "type": "CheckBox",
      "name": "AllowScriptSourceRead",
      "caption": "Skriptquelltexte und Ereignis-Code in lesbaren Bereichen freigeben"
    },
    {
      "type": "CheckBox",
      "name": "AllowMediaContentRead",
      "caption": "Medieninhalte in lesbaren Bereichen freigeben (z. B. IPSView-Dateien)"
    },
    {
      "type": "CheckBox",
      "name": "AllowWrite",
      "caption": "Objekte anlegen und Variablen schreiben"
    },
    {
      "type": "CheckBox",
      "name": "AllowExecute",
      "caption": "PHP ausführen, bestehende Skripte ändern und Ereignisse konfigurieren (volle Symcon-Rechte)"
    },
    {
      "type": "Label",
      "caption": "PHP-Ausführung ist keine Sandbox: gestartete Skripte können Kategorien-Sperren umgehen. Leserechte und Sperren gelten für direkte MCP-Werkzeuge. Kennwörter außerhalb gesperrter Bereiche werden nicht automatisch erkannt."
    },
    {
      "type": "ValidationTextBox",
      "name": "Origins",
      "caption": "Erlaubte Browser-Origins, kommasepariert (leer: keine Browser)"
    },
    {
      "type": "CheckBox",
      "name": "DebugEnabled",
      "caption": "Debug-Ausgaben aktivieren (ohne Token, Quelltexte und Variablenwerte)"
    }
  ],
  "status": [
    {
      "code": 200,
      "icon": "error",
      "caption": "Token oder Kategorie-/Instanzauswahl ungültig / kein lesbarer Bereich"
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "Neuer Token wird erst mit Änderungen übernehmen aktiv. Bestehende ChatGPT-Verbindungen benötigen danach den neuen Token."
    },
    {
      "type": "Button",
      "caption": "Neuen Token erzeugen",
      "onClick": "SMCP_UIGenerateToken($id);"
    },
    {
      "type": "Button",
      "caption": "Gespeicherten Token anzeigen / kopieren",
      "onClick": "SMCP_UIShowToken($id);"
    },
    {
      "type": "Button",
      "caption": "ChatGPT-Adresse anzeigen / kopieren",
      "onClick": "SMCP_UIShowChatGPTAddress($id);"
    },
    {
      "type": "PopupAlert",
      "name": "CopyPopup",
      "visible": false,
      "popup": {
        "caption": "Token kopieren",
        "width": "70%",
        "closeCaption": "Schließen",
        "items": [
          {
            "type": "Label",
            "name": "CopyCaption",
            "caption": ""
          },
          {
            "type": "ValidationTextBox",
            "name": "CopyValue",
            "caption": "Token (Strg+A, Strg+C)",
            "width": "100%",
            "value": ""
          }
        ]
      }
    }
  ]
}
